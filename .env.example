# Cloudflare Turnstile ("prove you're human" widget) — signup forms only.
# TURNSTILE_SITE_KEY is public and safe to expose to the frontend (served via GET /api/config).
# TURNSTILE_SECRET_KEY must stay server-side only — never commit a real value.
#
# For local development, use Cloudflare's official "always passes" test keys:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000AA

# Identity/age verification (Trust Level 3) — see lib/identity-verification.js.
# "none" (default) reports this channel as honestly not-yet-available; nothing
# pretends to verify anyone. "dev" instantly passes for local testing only —
# never set this in production. "yoti" / "persona" need real credentials AND
# the TODO in lib/identity-verification.js finished against that provider's
# current API before they'll do anything beyond return a clear error.
IDENTITY_VERIFICATION_PROVIDER=none
IDENTITY_VERIFICATION_API_KEY=
IDENTITY_VERIFICATION_API_SECRET=
# Shared secret used to verify the provider's webhook signature — get this
# from the provider's dashboard once an account exists.
IDENTITY_VERIFICATION_WEBHOOK_SECRET=
